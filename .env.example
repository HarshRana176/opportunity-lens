# Copy to .env and fill in real values. NEVER commit .env (it is gitignored).

# ---- Required ----
# PostgreSQL connection string.
DATABASE_URL=postgresql://postgres:password@localhost:5432/resume_parser

# ---- Optional: uploads ----
# UPLOAD_DIR=uploads
# MAX_UPLOAD_BYTES=10485760

# ---- Optional: online job discovery (Adzuna) ----
# Free developer credentials: https://developer.adzuna.com/
# When these are absent, POST /job-matches still works -- it simply
# skips online discovery and matches against already-persisted jobs,
# reporting discovery.status = "not_configured".
# ADZUNA_APP_ID=your_app_id_here
# ADZUNA_APP_KEY=your_app_key_here
# Country code: gb, us, au, ca, de, fr, in, ... (default: gb)
# ADZUNA_COUNTRY=gb
# ADZUNA_TIMEOUT_SECONDS=15

# ---- Optional: embeddings (used only when project_evidence_weight > 0) ----
# EMBEDDING_MODEL=nomic-embed-text
# OLLAMA_HOST=http://localhost:11434
# EMBEDDING_TIMEOUT_SECONDS=30
